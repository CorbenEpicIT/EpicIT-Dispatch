# Port for server
SERVER_PORT="3000"

# DB Connection Info (Leave Default)
DB_HOST="db"
DB_PORT="5432"
DB_USER="hvac_user"
DB_PASS="hvac_pass"
DB_NAME="hvac_db"

# Prisma needs this. Connection string for your local postgres environment
DATABASE_URL="postgresql://[user]:[password]@localhost:5432/[name of db]"

FRONTEND_URL="http://localhost:5173"

# JWT Secret for auth and refresh tokens
JWT_ACCESS_SECRET="";
JWT_REFRESH_SECRET="";
OTP_SECRET="";

# MFA Encryption 
MFA_ENCRYPTION_KEY=

# SSO Keys
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Find the following info in Confluence
MAPBOX_TOKEN=""

WASABI_ACCESS=""
WASABI_SECRET=""
WASABI_BUCKET="dispatch"
WASABI_REGION="us-central-1"

POSTMARK_API_KEY=""
POSTMARK_FROM_EMAIL="corben@epicitautomations.com"
# Shared secret guarding /integrations/postmark/webhook (followup open/bounce
# tracking). Required in production — the webhook fails closed if unset.
# Generate with: openssl rand -hex 32
POSTMARK_WEBHOOK_SECRET=

# Max image upload size in MB (default: 15)
MAX_UPLOAD_MB=15

# Grafana Cloud Loki — log forwarding (optional; omit to disable)
# Find these in your Grafana Cloud stack under: Connections > Loki
# HOST is the base URL only, e.g. https://logs-prod-006.grafana.net
GRAFANA_CLOUD_LOKI_HOST=
GRAFANA_CLOUD_LOKI_USERNAME=
GRAFANA_CLOUD_LOKI_PASSWORD=

# Grafana Cloud OTLP — metrics push (optional; omit to disable)
# Connections > Add new connection > OpenTelemetry > Direct > generate a token
# Copy OTEL_EXPORTER_OTLP_ENDPOINT and the value of OTEL_EXPORTER_OTLP_HEADERS verbatim
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_OTLP_AUTH=

# QuickBooks integration 
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI="http://localhost:3000/integrations/quickbooks/callback"
QB_ENVIRONMENT="sandbox"
QB_WEBHOOK_VERIFIER_TOKEN=

# Receipt OCR — auto-fills a field purchase from a photographed receipt.
# Optional: leave unset (or "none") and every upload stamps ocr_status="skipped",
# which is a supported end state — the technician types the lines by hand.
#   none      (default) no reading; manual entry only
#   fixture   a checked-in sample receipt, keyless and offline. Auto-fill is
#             demonstrable and E2E-testable with no vendor account. It invents a
#             receipt and ignores the photo, so it is REFUSED when
#             NODE_ENV=production — the server disables OCR instead.
#   mindee    live extraction, needs MINDEE_API_KEY and MINDEE_MODEL_ID
RECEIPT_OCR_PROVIDER=none

# Placeholders. Put real keys in backend/.env, which is gitignored — never here.
# MINDEE_MODEL_ID is the UUID of a model created from the Receipt catalogue
# template in your own Mindee console: V2 mints one per organization, so there is
# no shared ID to default to and the adapter refuses to guess.
MINDEE_API_KEY=
MINDEE_MODEL_ID=
